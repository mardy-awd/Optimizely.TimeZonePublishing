<?xml version="1.0" encoding="utf-8"?>
<module>
    <dojo>
        <paths>
            <add name="timezonepublishing"
                 path="ClientResources/TimeZonePublishing" />
        </paths>
    </dojo>

    <clientModule initializer="timezonepublishing/ModuleInitializer">
        <moduleDependencies>
            <add dependency="CMS" type="RunAfter" />
        </moduleDependencies>
    </clientModule>
</module>