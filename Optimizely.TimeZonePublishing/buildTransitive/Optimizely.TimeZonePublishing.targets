
<Project>
  <ItemGroup>
    <TimeZonePublishingModuleZip Include="$(MSBuildThisFileDirectory)..\contentFiles\any\net10.0\modules\_protected\TimeZonePublishing\TimeZonePublishing.zip" />
  </ItemGroup>

  <Target Name="CopyTimeZonePublishingModule"
          BeforeTargets="Build"
          Condition="Exists('@(TimeZonePublishingModuleZip)')">

    <Copy
      SourceFiles="@(TimeZonePublishingModuleZip)"
      DestinationFolder="$(MSBuildProjectDirectory)\modules\_protected\TimeZonePublishing\"
      SkipUnchangedFiles="true" />

  </Target>
</Project>